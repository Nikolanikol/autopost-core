# Скопируйте в .env (файл .env никому не отправляйте и не коммитьте)

# Postgres (локально: pnpm db:start; на сервере — Postgres из Supabase/Coolify)
DATABASE_URL=postgres://autopost@localhost:54329/autopost

# 32 байта в base64: openssl rand -base64 32 — шифрует токены соцсетей в БД
APP_ENCRYPTION_KEY=

# Хранилище загруженных файлов и их публичный адрес.
# Instagram скачивает медиа сам: для публикации загруженных файлов нужен публичный https
# (адрес сервера, например https://post.example.com, или туннель ngrok при локальной работе).
PUBLIC_BASE_URL=http://localhost:3100
# STORAGE_DIR=./storage

# Вход в интерфейс (Basic Auth)
ADMIN_USER=admin
ADMIN_PASSWORD=

# Для импорта аккаунта командой pnpm seed:ig и для ig-test.mjs
IG_ACCESS_TOKEN=
IG_USER_ID=

# Необязательно:
# GRAPH_VERSION=v24.0
# GRAPH_HOST=graph.facebook.com
# METRICS_INTERVAL_MIN=180

# Вебхуки Instagram (комментарии, упоминания, сообщения):
# адрес для Meta: https://<ваш-домен>/api/webhooks/instagram
# META_APP_SECRET — «Настройки приложения → Основное → Секрет приложения» (проверка подписи событий)
META_APP_SECRET=
# IG_WEBHOOK_VERIFY_TOKEN — любая случайная строка, её же вводите в Meta при настройке вебхука
IG_WEBHOOK_VERIFY_TOKEN=

# Комментарии (необязательно):
# COMMENT_AUTO_PER_HOUR=15        — лимит автоответов в час на аккаунт
# COMMENT_AUTO_MAX_AGE_MIN=120    — автоответ только на комментарии не старше N минут
# COMMENTS_INTERVAL_MIN=15        — как часто worker опрашивает комментарии (страховка к вебхуку)

# TikTok (загрузка в черновики, см. docs/TIKTOK.md):
# ключи приложения из developers.tiktok.com → Manage apps
# Redirect URI в кабинете: <PUBLIC_BASE_URL>/api/oauth/tiktok/callback (только https)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
