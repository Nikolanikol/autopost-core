# Скопируйте в .env (файл .env никому не отправляйте и не коммитьте)

# Postgres (локально: pnpm db:start; на сервере — Postgres из Supabase/Coolify)
DATABASE_URL=postgres://autopost@localhost:54329/autopost

# 32 байта в base64: openssl rand -base64 32 — шифрует токены соцсетей в БД
APP_ENCRYPTION_KEY=

# Хранилище загруженных файлов и их публичный адрес.
# Instagram скачивает медиа сам: для публикации загруженных файлов нужен публичный https
# (адрес сервера, например https://post.example.com, или туннель ngrok при локальной работе).
PUBLIC_BASE_URL=http://localhost:3100
# STORAGE_DIR=./storage

# Вход в интерфейс (Basic Auth)
ADMIN_USER=admin
ADMIN_PASSWORD=

# Для импорта аккаунта командой pnpm seed:ig и для ig-test.mjs
IG_ACCESS_TOKEN=
IG_USER_ID=

# Необязательно:
# GRAPH_VERSION=v24.0
# GRAPH_HOST=graph.facebook.com
