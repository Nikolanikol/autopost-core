{
  "name": "autopost-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "worker": "tsx --env-file=.env src/worker/index.ts",
    "db:start": "bash scripts/db.sh start",
    "db:stop": "bash scripts/db.sh stop",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts",
    "seed:ig": "tsx --env-file=.env scripts/seed-ig-account.ts",
    "typecheck": "tsc --noEmit",
    "ig:check": "node --env-file=.env ig-test.mjs check"
  },
  "dependencies": {
    "next": "^15.5.29",
    "pg": "^8.23.1",
    "pg-boss": "^10.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
